{
  "banner": "always",
  "experimental": true,
  "mouse": true,
  "bashEnv": true,
  "theme": "auto",
  "effortLevel": "medium",
  "colorMode": "default",
  "model": "gpt-5.6-sol",
  "contextTier": "long_context",
  "remote": "on",
  "powershellFlags": ["-NoLogo"],
  "extraKnownMarketplaces": {
    "scarypilot": {
      "source": {
        "source": "github",
        "repo": "scaryrawr/scarypilot"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "copilot-autoresearch@scarypilot": true,
    "copilot-local-llm@scarypilot": true,
    "digivolution@scarypilot": true,
    "pstack@scarypilot": true
  },
  "subagents": {
    "agents": {
      "explore": {
        "model": "gpt-5.6-luna",
        "effortLevel": "medium"
      },
      "task": {
        "model": "gpt-5.6-luna",
        "effortLevel": "medium"
      },
      "research": {
        "model": "gpt-5.6-terra",
        "effortLevel": "medium",
        "contextTier": "default"
      },
      "security-review": {
        "model": "gpt-5.6-sol",
        "effortLevel": "high",
        "contextTier": "default"
      }
    }
  }
}
